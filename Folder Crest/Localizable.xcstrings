{
  "sourceLanguage": "en",
  "strings": {
    "A dropped folder replaces the target and gets its icon set directly.": {
      "comment": "Hint under the destination row",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gezogener Ordner ersetzt das Ziel und erhält sein Icon direkt."
          }
        }
      }
    },
    "Appearance": {
      "comment": "Label of the light/dark mode picker",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild"
          }
        }
      }
    },
    "Apply to Folder": {
      "comment": "Primary button that writes the icon onto a folder",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Ordner anwenden"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "de": {
          "stringUnit": {
